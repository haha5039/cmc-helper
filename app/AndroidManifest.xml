<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.haha5039.cmc" android:versionCode="6" android:versionName="1.4.0">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <queries>
        <package android:name="com.samsung.android.mdecservice" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application android:name=".CmcApplication" android:label="CMC Helper"
        android:theme="@style/AppTheme" android:icon="@drawable/ic_launcher"
        android:allowBackup="false" android:debuggable="false"
        android:supportsRtl="true" android:usesCleartextTraffic="false">
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.haha5039.cmc.shizuku" android:exported="true"
            android:enabled="true" android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".OtpCalculatorActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
    <instrumentation android:name=".PrepareInstrumentation"
        android:targetPackage="com.haha5039.cmc" android:functionalTest="true" />
    <instrumentation android:name=".ControlInstrumentation"
        android:targetPackage="com.haha5039.cmc" android:functionalTest="true" />
</manifest>
